# Copy to .env and fill in. Never commit .env.

# Model for the copilot. Any OpenAI-compatible endpoint works.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=

# Optional. responses = OpenAI Responses API (default for api.openai.com), chat = Chat Completions (default elsewhere).
# LLM_API_STYLE=auto
# Optional, Responses API only: low | medium | high, or "off" to omit the parameter.
# LLM_REASONING_EFFORT=medium

# Only for the hosted Synapse variant (python scripts/build_mcp.py --mode hosted).
SYNAPSE_API_KEY=
